# MarkTheDate 后端配置示例
# 复制为 .env 并按需修改。

# ===== 服务 =====
HOST=0.0.0.0
PORT=8000
# CORS 允许的来源，逗号分隔字符串
CORS_ORIGINS=http://localhost:3000,http://localhost

# ===== 数据库 / 本地临时目录 =====
DB_PATH=./data/markthedate.db
TMP_DIR=./data/tmp

# ===== 存储后端 =====
# 可选值：
#   s3   — 兼容 Amazon S3 协议的对象存储（推荐 rustfs / MinIO / AWS S3）
#   local — 直接用本地文件系统（开发 / 单机部署）
STORAGE_BACKEND=s3

# 本地存储根目录（仅 STORAGE_BACKEND=local 时生效）
STORAGE_LOCAL_ROOT=./data/events

# ---- S3 / rustfs 配置 ----
# rustfs 默认 S3 API 端口是 9000（Web 控制台在 9001）
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=markthedate
S3_REGION=us-east-1
# rustfs / MinIO 必须为 True（路径风格访问），AWS S3 默认 False（virtual-hosted）
S3_PATH_STYLE=true
# 若桶可公开访问或经 CDN 暴露，可填此 URL 直链；留空则用预签名 URL（短时效）
S3_PUBLIC_BASE_URL=
# 预签名 URL 时效（秒）
S3_PRESIGN_EXPIRES=3600

# ===== AI =====
AI_PROVIDER=openai  # openai | ollama
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-xxxxxxxx
AI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ===== 邮件 SMTP（可选，留空关闭） =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=